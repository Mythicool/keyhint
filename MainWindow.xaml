<Window x:Class="KeyHint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyHint" Width="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" SizeToContent="Height" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="#B0FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#F5131318" BorderBrush="#30FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <StackPanel>
            <Grid Margin="14,12,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,1,6,0">
                    <TextBlock x:Name="ItemText" Text="Click a menu or button" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AppText" Text="Its keyboard shortcut will show up here" FontSize="12" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="HistoryButton" Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Show the last few shortcuts" Click="History_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Hide (it stays in the tray)" Click="Hide_Click" />
                </StackPanel>
            </Grid>

            <WrapPanel x:Name="KeysPanel" Margin="14,10,14,0" Visibility="Collapsed" RenderTransformOrigin="0,0.5">
                <WrapPanel.RenderTransform>
                    <ScaleTransform x:Name="KeysScale" />
                </WrapPanel.RenderTransform>
            </WrapPanel>

            <TextBlock x:Name="NoteText" Margin="14,8,14,0" FontSize="11" Foreground="#80FFFFFF" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="MissText" Margin="14,6,14,0" FontSize="11" Foreground="#59FFFFFF" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />

            <StackPanel x:Name="HistoryPanel" Margin="14,10,14,0" Visibility="Collapsed" />

            <Border Height="12" />
        </StackPanel>
    </Border>
</Window>
